<Window x:Class="Player.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:r="clr-namespace:Player.App.Resources"
        xmlns:vm="clr-namespace:Player.App.ViewModels"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:s="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
        xmlns:c="clr-namespace:Player.App.Controls"
        xmlns:p="clr-namespace:Player.Core.Playback;assembly=Player.Core"
        Style="{StaticResource {x:Type Window}}"
        WindowStyle="None" Title="{Binding ProductName}" Width="920" Height="820" MinWidth="640" MinHeight="520"
        AllowDrop="True" Drop="OnDrop" DragOver="OnDragOver" PreviewKeyDown="OnKeyDown" Closing="OnClosing">
    <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="36" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" /></shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <r:EnumLabelConverter x:Key="EnumLabel" />
        <ContextMenu x:Key="PlaylistTabMenu">
            <MenuItem Header="{r:Loc RenamePlaylist}" Tag="Rename" Click="OnTabMenuAction" ><MenuItem.Icon><c:AppIcon Kind="Edit" /></MenuItem.Icon></MenuItem>
            <MenuItem Header="{r:Loc DuplicatePlaylist}" Tag="Duplicate" Click="OnTabMenuAction" ><MenuItem.Icon><c:AppIcon Kind="Copy" /></MenuItem.Icon></MenuItem>
            <Separator />
            <MenuItem Header="{r:Loc TabLeft}" Tag="Left" Click="OnTabMenuAction" ><MenuItem.Icon><c:AppIcon Kind="Previous" /></MenuItem.Icon></MenuItem>
            <MenuItem Header="{r:Loc TabRight}" Tag="Right" Click="OnTabMenuAction" ><MenuItem.Icon><c:AppIcon Kind="Next" /></MenuItem.Icon></MenuItem>
            <MenuItem Header="{r:Loc SortPlaylist}"><MenuItem.Icon><c:AppIcon Kind="Down" /></MenuItem.Icon>
                <MenuItem Header="{r:Loc SortTitle}" Tag="Title" Click="OnTabSort" />
                <MenuItem Header="{r:Loc SortArtist}" Tag="Artist" Click="OnTabSort" />
                <MenuItem Header="{r:Loc SortAlbum}" Tag="Album" Click="OnTabSort" />
                <MenuItem Header="{r:Loc SortTrack}" Tag="Track" Click="OnTabSort" />
                <MenuItem Header="{r:Loc SortDuration}" Tag="Duration" Click="OnTabSort" />
                <MenuItem Header="{r:Loc SortPath}" Tag="Path" Click="OnTabSort" />
                <MenuItem Header="{r:Loc SortAdded}" Tag="Date added" Click="OnTabSort" />
            </MenuItem>
            <MenuItem Header="{r:Loc RemoveDuplicates}" Tag="Duplicates" Click="OnTabMenuAction" ><MenuItem.Icon><c:AppIcon Kind="Delete" /></MenuItem.Icon></MenuItem>
            <MenuItem Header="{r:Loc ExportPlaylist}" Tag="Export" Click="OnTabMenuAction" ><MenuItem.Icon><c:AppIcon Kind="Export" /></MenuItem.Icon></MenuItem>
            <Separator />
            <MenuItem Header="{r:Loc DeletePlaylist}" Tag="Delete" Click="OnTabMenuAction" ><MenuItem.Icon><c:AppIcon Kind="Delete" /></MenuItem.Icon></MenuItem>
        </ContextMenu>
    </Window.Resources>
    <Window.InputBindings>
        <KeyBinding Key="O" Modifiers="Control" Command="{Binding AddFilesCommand}" />
        <KeyBinding Key="O" Modifiers="Control+Shift" Command="{Binding AddFolderCommand}" />
        <KeyBinding Key="Left" Modifiers="Alt" Command="{Binding PreviousCommand}" />
        <KeyBinding Key="Right" Modifiers="Alt" Command="{Binding NextCommand}" />
    </Window.InputBindings>
    <Grid Background="{DynamicResource BackgroundBrush}" TextOptions.TextFormattingMode="Display">
        <Grid.RowDefinitions>
            <RowDefinition Height="36" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <DockPanel Grid.Row="0" Background="{DynamicResource SurfaceBrush}" MouseDown="OnSystemMenu">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="SettingsButton"  Click="OnPreferences" ToolTip="{r:Loc Settings}" AutomationProperties.Name="{r:Loc Settings}" shell:WindowChrome.IsHitTestVisibleInChrome="True" Background="Transparent" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,8,0" Style="{StaticResource IconButton}"><c:AppIcon Kind="Settings" /></Button>
                <Button  Click="OnMinimize" ToolTip="{r:Loc Minimize}" AutomationProperties.Name="{r:Loc Minimize}" shell:WindowChrome.IsHitTestVisibleInChrome="True" Background="Transparent" Foreground="{DynamicResource TextPrimaryBrush}" Style="{StaticResource IconButton}"><c:AppIcon Kind="Minimize" /></Button>
                <Button  Click="OnMaximize" ToolTip="{r:Loc Maximize}" AutomationProperties.Name="{r:Loc Maximize}" shell:WindowChrome.IsHitTestVisibleInChrome="True" Background="Transparent" Foreground="{DynamicResource TextPrimaryBrush}" Style="{StaticResource IconButton}"><c:AppIcon Kind="Maximize" /></Button>
                <Button  Click="OnCloseWindow" ToolTip="{r:Loc Close}" AutomationProperties.Name="{r:Loc Close}" shell:WindowChrome.IsHitTestVisibleInChrome="True" Background="Transparent" Foreground="{DynamicResource TextPrimaryBrush}" Style="{StaticResource IconButton}"><c:AppIcon Kind="Close" /></Button>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="12,0" VerticalAlignment="Center"><Image Source="/MPswift;component/Assets/MPswift.png" Width="18" Height="18" Margin="0,0,9,0" /><TextBlock Text="{Binding ProductName}" FontSize="13" FontWeight="SemiBold" /><TextBlock x:Name="BuildVersionText" Text="{Binding ProductVersion}" Margin="8,0,0,0" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" /></StackPanel>
        </DockPanel>
        <Border Grid.Row="1" Margin="16,12,16,4" Background="{DynamicResource SurfaceBrush}" CornerRadius="12" Padding="12"><Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="100" /><ColumnDefinition Width="*" /><ColumnDefinition Width="170" /></Grid.ColumnDefinitions>
            <Border CornerRadius="9" Width="88" Height="88" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" HorizontalAlignment="Left">
                <Grid><Image AutomationProperties.Name="{r:Loc Artwork}" Source="{Binding CoverArt}" Stretch="Uniform" />
                    <Image Source="/MPswift;component/Assets/MPswift.png" Width="58" Height="58" Opacity="0.8"><Image.Style><Style TargetType="Image"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding CoverArt}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Image.Style></Image>
                </Grid>
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                <TextBlock x:Name="NowPlayingTitle" Text="{Binding Title}" FontSize="22" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}" />
                <TextBlock Text="{Binding Artist}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding Album}" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding PlaybackSource}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding Format}" FontSize="11" Margin="0,5,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Format}" Foreground="{DynamicResource TextSecondaryBrush}" />
            </StackPanel>
            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                <TextBlock x:Name="PlaybackStateText" AutomationProperties.LiveSetting="Polite" Text="{Binding State}" HorizontalAlignment="Right" Foreground="{DynamicResource AccentBrush}" />
                <TextBlock Text="{r:Loc Volume}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,8,0,0" />
                <Slider x:Name="VolumeSlider" Value="{Binding Volume, Mode=TwoWay}" Minimum="0" Maximum="100" TickFrequency="5" SmallChange="5" IsMoveToPointEnabled="True" AutomationProperties.Name="{r:Loc Volume}" />
                <CheckBox x:Name="MuteBox" IsChecked="{Binding Muted}" ToolTip="{r:Loc Mute}" AutomationProperties.Name="{r:Loc Mute}"><c:AppIcon><c:AppIcon.Style><Style TargetType="c:AppIcon"><Setter Property="Kind" Value="Volume" /><Style.Triggers><DataTrigger Binding="{Binding Muted}" Value="True"><Setter Property="Kind" Value="Muted" /></DataTrigger></Style.Triggers></Style></c:AppIcon.Style></c:AppIcon></CheckBox>
            </StackPanel>
        </Grid></Border>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,6" IsEnabled="{Binding CanTransport}">
            <CheckBox IsChecked="{Binding Shuffle}" VerticalAlignment="Center" Margin="6" ToolTip="{r:Loc Shuffle}" AutomationProperties.Name="{r:Loc Shuffle}"><c:AppIcon Kind="Shuffle" /></CheckBox>
            <ComboBox x:Name="RepeatBox" ItemsSource="{Binding RepeatModes}" SelectedItem="{Binding Repeat}" Width="52" VerticalAlignment="Center" AutomationProperties.Name="{r:Loc Repeat}" Margin="4">
                <ComboBox.ToolTip><MultiBinding Converter="{StaticResource EnumLabel}"><Binding Path="Repeat" /><Binding Path="Culture" Source="{x:Static r:LocalizedStrings.Instance}" /></MultiBinding></ComboBox.ToolTip>
                <ComboBox.ItemTemplate><DataTemplate><c:AppIcon>
                    <c:AppIcon.ToolTip><MultiBinding Converter="{StaticResource EnumLabel}"><Binding /><Binding Path="Culture" Source="{x:Static r:LocalizedStrings.Instance}" /></MultiBinding></c:AppIcon.ToolTip>
                    <c:AppIcon.Style><Style TargetType="c:AppIcon"><Setter Property="Kind" Value="RepeatOff" /><Style.Triggers><DataTrigger Binding="{Binding}" Value="{x:Static p:RepeatMode.All}"><Setter Property="Kind" Value="RepeatAll" /></DataTrigger><DataTrigger Binding="{Binding}" Value="{x:Static p:RepeatMode.One}"><Setter Property="Kind" Value="RepeatOne" /></DataTrigger></Style.Triggers></Style></c:AppIcon.Style>
                </c:AppIcon></DataTemplate></ComboBox.ItemTemplate>
                <ComboBox.ItemContainerStyle><Style TargetType="ComboBoxItem" BasedOn="{StaticResource {x:Type ComboBoxItem}}"><Setter Property="AutomationProperties.Name"><Setter.Value><MultiBinding Converter="{StaticResource EnumLabel}"><Binding /><Binding Path="Culture" Source="{x:Static r:LocalizedStrings.Instance}" /></MultiBinding></Setter.Value></Setter></Style></ComboBox.ItemContainerStyle>
            </ComboBox>
            <Button Command="{Binding PreviousCommand}" Margin="4" Style="{StaticResource IconButton}" ToolTip="{r:Loc Previous}" AutomationProperties.Name="{r:Loc Previous}"><c:AppIcon Kind="Previous" /></Button>
            <Button Command="{Binding StopCommand}" Margin="4" Style="{StaticResource IconButton}" ToolTip="{r:Loc Stop}" AutomationProperties.Name="{r:Loc Stop}"><c:AppIcon Kind="Stop" /></Button>
            <Button x:Name="PlayPauseButton" Style="{StaticResource AccentButton}" Command="{Binding PlayPauseCommand}" Margin="8,0" Width="48" Height="42" Padding="0" ToolTip="{Binding PlayPauseLabel}" AutomationProperties.Name="{Binding PlayPauseLabel}">
                <c:AppIcon Foreground="{DynamicResource AccentTextBrush}"><c:AppIcon.Style><Style TargetType="c:AppIcon"><Setter Property="Kind" Value="Play" /><Style.Triggers><DataTrigger Binding="{Binding IsPlaying}" Value="True"><Setter Property="Kind" Value="Pause" /></DataTrigger></Style.Triggers></Style></c:AppIcon.Style></c:AppIcon>
            </Button>
            <Button Command="{Binding NextCommand}" Margin="4" Style="{StaticResource IconButton}" ToolTip="{r:Loc Next}" AutomationProperties.Name="{r:Loc Next}"><c:AppIcon Kind="Next" /></Button>
        </StackPanel>
        <Grid Grid.Row="3" Margin="16,0,16,8">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="44" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <TextBlock Text="{Binding WaveformStatus}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
            <c:WaveformControl x:Name="WaveformView" Grid.Row="1" Focusable="True" AutomationProperties.Name="{r:Loc Seek}" Data="{Binding Waveform}" UsePeaks="{Binding UsePeakWaveform}" Position="{Binding SeekPosition}" Duration="{Binding DurationSeconds}" CanSeek="{Binding CanSeek}" />
            <Slider x:Name="SeekSlider" Grid.Row="2" Value="{Binding SeekPosition, Mode=TwoWay}" Maximum="{Binding DurationSeconds}" Minimum="0"
                    IsEnabled="{Binding CanSeek}" SmallChange="5" LargeChange="30" IsMoveToPointEnabled="True"
                    AutomationProperties.Name="{r:Loc Seek}" Margin="0,4" PreviewMouseLeftButtonDown="OnSeekStart"
                    PreviewMouseLeftButtonUp="OnSeekEnd" LostMouseCapture="OnSeekCaptureLost" />
            <DockPanel Grid.Row="3" TextElement.FontSize="11" TextElement.Foreground="{DynamicResource TextSecondaryBrush}"><TextBlock Text="{Binding Elapsed}" /><TextBlock Text="{Binding DurationText}" HorizontalAlignment="Right" /></DockPanel>
        </Grid>
        <DockPanel x:Name="PlaylistTabStrip" Grid.Row="4" Margin="16,4,16,0" Background="{DynamicResource BackgroundBrush}" ToolTip="{r:Loc FolderDropHint}">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button  Click="OnCreatePlaylist" ToolTip="{r:Loc NewPlaylist}" AutomationProperties.Name="{r:Loc NewPlaylist}" Margin="2" Style="{StaticResource IconButton}"><c:AppIcon Kind="Add" /></Button>
                <Button x:Name="PlaylistActions"  Click="OnPlaylistActions" ToolTip="{r:Loc PlaylistActions}" AutomationProperties.Name="{r:Loc PlaylistActions}" Margin="2" Style="{StaticResource IconButton}"><c:AppIcon Kind="More" />
                    <Button.ContextMenu><ContextMenu>
                        <MenuItem Header="{r:Loc PlaylistMenu}"><MenuItem.Icon><c:AppIcon Kind="Queue" /></MenuItem.Icon>
                        <MenuItem Header="{r:Loc RenamePlaylist}" Click="OnRenamePlaylist" ><MenuItem.Icon><c:AppIcon Kind="Edit" /></MenuItem.Icon></MenuItem>
                        <MenuItem Header="{r:Loc DuplicatePlaylist}" Click="OnDuplicatePlaylist" ><MenuItem.Icon><c:AppIcon Kind="Copy" /></MenuItem.Icon></MenuItem>
                        <MenuItem Header="{r:Loc RemoveDuplicates}" Click="OnRemoveDuplicates" ><MenuItem.Icon><c:AppIcon Kind="Delete" /></MenuItem.Icon></MenuItem>
                        <MenuItem Header="{r:Loc TabLeft}" Click="OnTabLeft" ><MenuItem.Icon><c:AppIcon Kind="Previous" /></MenuItem.Icon></MenuItem>
                        <MenuItem Header="{r:Loc TabRight}" Click="OnTabRight" ><MenuItem.Icon><c:AppIcon Kind="Next" /></MenuItem.Icon></MenuItem>
                        <MenuItem Header="{r:Loc DeletePlaylist}" Click="OnDeletePlaylist" ><MenuItem.Icon><c:AppIcon Kind="Delete" /></MenuItem.Icon></MenuItem>
                        </MenuItem>
                        <MenuItem Header="{r:Loc SortPlaylist}"><MenuItem.Icon><c:AppIcon Kind="Down" /></MenuItem.Icon><MenuItem Header="{r:Loc SortTitle}" Tag="Title" Click="OnSort" /><MenuItem Header="{r:Loc SortArtist}" Tag="Artist" Click="OnSort" /><MenuItem Header="{r:Loc SortAlbum}" Tag="Album" Click="OnSort" /><MenuItem Header="{r:Loc SortTrack}" Tag="Track" Click="OnSort" /><MenuItem Header="{r:Loc SortDuration}" Tag="Duration" Click="OnSort" /><MenuItem Header="{r:Loc SortPath}" Tag="Path" Click="OnSort" /><MenuItem Header="{r:Loc SortAdded}" Tag="Date added" Click="OnSort" /></MenuItem>
                        <MenuItem Header="{r:Loc SelectedTracksMenu}"><MenuItem.Icon><c:AppIcon Kind="Play" /></MenuItem.Icon>
                        <MenuItem Header="{r:Loc ExpandCueImage}" Click="OnExpandCueImage" />
                        <MenuItem Header="{r:Loc PlayNext}" Click="OnPlayNext" ><MenuItem.Icon><c:AppIcon Kind="Next" /></MenuItem.Icon></MenuItem>
                        <MenuItem Header="{r:Loc AddQueue}" Click="OnAddQueue" ><MenuItem.Icon><c:AppIcon Kind="Queue" /></MenuItem.Icon></MenuItem>
                        <MenuItem Header="{r:Loc MoveUp}" Click="OnMoveUp" ><MenuItem.Icon><c:AppIcon Kind="Up" /></MenuItem.Icon></MenuItem>
                        <MenuItem Header="{r:Loc MoveDown}" Click="OnMoveDown" ><MenuItem.Icon><c:AppIcon Kind="Down" /></MenuItem.Icon></MenuItem>
                        <Separator />
                        <MenuItem Header="{r:Loc CopyPath}" Click="OnCopyPath" ><MenuItem.Icon><c:AppIcon Kind="Copy" /></MenuItem.Icon></MenuItem>
                        <MenuItem Header="{r:Loc ShowFile}" Click="OnShowFile" ><MenuItem.Icon><c:AppIcon Kind="Folder" /></MenuItem.Icon></MenuItem>
                        <MenuItem Header="{r:Loc Properties}" Click="OnProperties" ><MenuItem.Icon><c:AppIcon Kind="Help" /></MenuItem.Icon></MenuItem>
                        <MenuItem Header="{r:Loc Relink}" Click="OnRelink" />
                        </MenuItem>
                        <MenuItem Header="{r:Loc QueueMenu}"><MenuItem.Icon><c:AppIcon Kind="Queue" /></MenuItem.Icon>
                            <MenuItem Header="{r:Loc ShowQueue}" Click="OnQueue" ><MenuItem.Icon><c:AppIcon Kind="Queue" /></MenuItem.Icon></MenuItem>
                            <MenuItem Header="{r:Loc ClearHistory}" Command="{Binding ClearHistoryCommand}" ><MenuItem.Icon><c:AppIcon Kind="Delete" /></MenuItem.Icon></MenuItem>
                        </MenuItem>
                        <Separator />
                        <MenuItem Header="{r:Loc Library}" Click="OnLibrary" ><MenuItem.Icon><c:AppIcon Kind="Folder" /></MenuItem.Icon></MenuItem>
                        <MenuItem Header="{r:Loc FilesMenu}"><MenuItem.Icon><c:AppIcon Kind="Folder" /></MenuItem.Icon>
                        <MenuItem Header="{r:Loc ExportPlaylist}" Click="OnExportPlaylist" ><MenuItem.Icon><c:AppIcon Kind="Export" /></MenuItem.Icon></MenuItem>
                        <MenuItem Header="{r:Loc LegacyImport}" Click="OnLegacyImport" />
                        <MenuItem Header="{r:Loc Backup}" Click="OnBackup" ><MenuItem.Icon><c:AppIcon Kind="Backup" /></MenuItem.Icon></MenuItem>
                        <MenuItem Header="{r:Loc RestoreBackup}" Click="OnRestoreBackup" ><MenuItem.Icon><c:AppIcon Kind="Restore" /></MenuItem.Icon></MenuItem>
                        </MenuItem>
                        <MenuItem Header="{r:Loc PreviewDiagnostics}" Click="OnDiagnostics" ><MenuItem.Icon><c:AppIcon Kind="Help" /></MenuItem.Icon></MenuItem>
                        <MenuItem Header="{r:Loc RefreshWaveform}" Command="{Binding RefreshWaveformCommand}" ><MenuItem.Icon><c:AppIcon Kind="Refresh" /></MenuItem.Icon></MenuItem>
                        <Separator />
                        <MenuItem Header="{r:Loc Settings}" Click="OnPreferences" ><MenuItem.Icon><c:AppIcon Kind="Settings" /></MenuItem.Icon></MenuItem>
                    </ContextMenu></Button.ContextMenu>
                </Button>
            </StackPanel>
            <ListBox x:Name="PlaylistTabs" ItemsSource="{Binding Playlists}" SelectedItem="{Binding SelectedPlaylist}" BorderThickness="0" Background="{DynamicResource BackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                     ContextMenuOpening="OnTabContextMenuOpening" PreviewMouseLeftButtonDown="OnTabDragStart" PreviewMouseMove="OnTabDragMove" DragLeave="OnTabDragLeave"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Disabled" AutomationProperties.Name="{r:Loc Playlists}">
                <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem">
                    <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
                    <Setter Property="ContextMenu" Value="{StaticResource PlaylistTabMenu}" />
                    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="TabBorder" CornerRadius="6,6,0,0" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="0,0,0,2"><ContentPresenter /></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="TabBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}" /><Setter Property="Foreground" Value="{DynamicResource AccentBrush}" /><Setter Property="Background" Value="{DynamicResource SurfaceBrush}" /></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="TabBorder" Property="BorderThickness" Value="1,1,1,3" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
                </Style></ListBox.ItemContainerStyle>
                <ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ListBox.ItemsPanel>
                <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" MinWidth="70" MaxWidth="200" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" Padding="8,6" /></DataTemplate></ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>
        <Grid Grid.Row="5" Margin="16,4,16,0">
            <ListBox x:Name="PlaylistList" ItemsSource="{Binding VisibleEntries}" SelectedItem="{Binding SelectedEntry}" SelectionMode="Extended"
                     Background="{DynamicResource BackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                     MouseDoubleClick="OnTrackDoubleClick" PreviewMouseLeftButtonDown="OnRowDragStart" PreviewMouseMove="OnRowDragMove" HorizontalContentAlignment="Stretch" AutomationProperties.Name="{Binding SelectedPlaylist.Name}">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Padding" Value="8,4" />
                        <Setter Property="MinHeight" Value="56" /><Setter Property="Margin" Value="0,1" /><Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                        <Setter Property="Background" Value="{DynamicResource AlternateRowBrush}" />
                        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><StackPanel>
                            <Border x:Name="AlbumHeading" Background="{DynamicResource BackgroundBrush}" Padding="10,12,10,8" ToolTip="{Binding SectionFolder}">
                                <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding HasSection}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Border.Style>
                                <StackPanel><TextBlock Text="{Binding SectionTitle}" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding SectionInfo}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" /></StackPanel>
                            </Border>
                            <Border x:Name="Row" CornerRadius="7" Background="{TemplateBinding Background}" BorderThickness="1" BorderBrush="Transparent" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" /></Border></StackPanel><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource HoverBrush}" /></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource SelectedRowBrush}" /><Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource AccentBrush}" /></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource TextPrimaryBrush}" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
                        <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
                        <Setter Property="AutomationProperties.HelpText" Value="{Binding Availability}" />
                        <Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{DynamicResource SelectedRowBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" /><Setter Property="BorderThickness" Value="1" /></Trigger></Style.Triggers>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:PlaylistRowViewModel}">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="28" /><ColumnDefinition Width="*" /><ColumnDefinition Width="116" /><ColumnDefinition Width="64" /></Grid.ColumnDefinitions>
                            <CheckBox IsChecked="{Binding Enabled}" VerticalAlignment="Center" AutomationProperties.Name="{r:Loc Enabled}" ToolTip="{r:Loc Enabled}" />
                            <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                <DockPanel>
                                    <c:AppIcon Kind="Play" Margin="0,0,6,0" Foreground="{DynamicResource AccentBrush}">
                                        <c:AppIcon.Style><Style TargetType="c:AppIcon"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding IsPlaying}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></c:AppIcon.Style>
                                    </c:AppIcon>
                                    <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}" />
                                </DockPanel>
                                <TextBlock Text="{Binding Metadata}" Margin="0,4,0,0" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <c:RatingStars Grid.Column="2" Rating="{Binding Rating, Mode=TwoWay}" VerticalAlignment="Center" ToolTip="{r:Loc RatingHelp}" AutomationProperties.Name="{r:Loc Rating}" AutomationProperties.HelpText="{r:Loc RatingHelp}" />
                            <StackPanel Grid.Column="3" HorizontalAlignment="Right" VerticalAlignment="Center" TextElement.Foreground="{DynamicResource TextSecondaryBrush}" TextElement.FontSize="12"><TextBlock Text="{Binding Duration}" /><TextBlock Text="{Binding Availability}" FontSize="10" Foreground="{DynamicResource ErrorBrush}" /></StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock Text="{r:Loc EmptyPlaylist}" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="360" Margin="16" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding HasEntries}" Value="False"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
            </TextBlock>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding HasEntries}" Value="True" /><Condition Binding="{Binding HasVisibleEntries}" Value="False" /></MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible" /></MultiDataTrigger></Style.Triggers></Style></StackPanel.Style>
                <TextBlock Text="{r:Loc EmptySearch}" TextWrapping="Wrap" Margin="8" />
                <Button Style="{StaticResource IconButton}" ToolTip="{r:Loc ClearSearch}" AutomationProperties.Name="{r:Loc ClearSearch}" Command="{Binding ClearSearchCommand}" HorizontalAlignment="Center"><c:AppIcon Kind="Close" /></Button>
            </StackPanel>
        </Grid>
        <StackPanel Grid.Row="6" Margin="16,4">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="{r:Loc CancelImport}" Command="{Binding CancelImportCommand}" Margin="4,0" Padding="8,2">
                    <Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding IsImporting}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Button.Style>
                </Button>
                <TextBlock Text="{Binding PlaylistStatus}" FontSize="11" /><TextBlock Text="{Binding SaveStatus}" FontSize="11" Margin="8,0,0,0" /><TextBlock x:Name="StatusMessageText" AutomationProperties.LiveSetting="Polite" Text="{Binding Message}" FontSize="11" TextWrapping="Wrap" Margin="12,0,0,0" />
            </DockPanel>
            <Expander Header="{r:Loc Details}"><Expander.Style><Style TargetType="Expander" BasedOn="{StaticResource {x:Type Expander}}"><Style.Triggers><DataTrigger Binding="{Binding Details}" Value=""><Setter Property="Visibility" Value="Collapsed" /></DataTrigger><DataTrigger Binding="{Binding Details}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></Expander.Style><TextBox Text="{Binding Details, Mode=OneWay}" IsReadOnly="True" MaxHeight="100" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" /></Expander>
        </StackPanel>
        <DockPanel Grid.Row="7" Background="{DynamicResource BackgroundBrush}" LastChildFill="True" Margin="8,4,8,8">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="4">
                <Button x:Name="AddFilesButton" Style="{StaticResource IconButton}" ToolTip="{r:Loc AddFiles}" AutomationProperties.Name="{r:Loc AddFiles}" Command="{Binding AddFilesCommand}" Margin="2"><c:AppIcon Kind="FileAdd" /></Button>
                <Button x:Name="AddFolderButton" Style="{StaticResource IconButton}" ToolTip="{r:Loc AddFolder}" AutomationProperties.Name="{r:Loc AddFolder}" Command="{Binding AddFolderCommand}" Margin="2"><c:AppIcon Kind="FolderAdd" /></Button>
                <Button  Style="{StaticResource IconButton}" ToolTip="{r:Loc Remove}" AutomationProperties.Name="{r:Loc Remove}" Click="OnRemove" Margin="2" ><c:AppIcon Kind="Delete" /></Button>
                <Button  Style="{StaticResource IconButton}" ToolTip="{r:Loc Help}" AutomationProperties.Name="{r:Loc Help}" Click="OnHelp" Margin="2" ><c:AppIcon Kind="Help" /></Button>
            </StackPanel>
            <Grid Margin="8,4">
                <TextBox x:Name="SearchBox" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged, Delay=200}" Margin="0" MinWidth="100" Padding="30,7,8,7" VerticalContentAlignment="Center"
                     ToolTip="{r:Loc Search}" AutomationProperties.Name="{r:Loc Search}" />
                <c:AppIcon Kind="Search" Margin="8,0,0,0" HorizontalAlignment="Left" Foreground="{DynamicResource TextSecondaryBrush}" />
                <TextBlock Text="{r:Loc Search}" Margin="31,0,8,0" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" IsHitTestVisible="False" TextTrimming="CharacterEllipsis"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value=""><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
            </Grid>
        </DockPanel>
    </Grid>
</Window>
