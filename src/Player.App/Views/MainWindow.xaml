<Window x:Class="Player.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:resources="clr-namespace:Player.App.Resources"
        Title="{Binding ProductName}" Width="840" Height="600" MinWidth="640" MinHeight="520">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock Text="{x:Static resources:Strings.StageTitle}" FontSize="20" Foreground="{StaticResource AccentBrush}" />
        <TextBlock Grid.Row="1" Text="{x:Static resources:Strings.StageDescription}" TextWrapping="Wrap" Margin="0,16,0,20" />
        <Button Grid.Row="2" Content="{x:Static resources:Strings.VerifyNative}" Command="{Binding VerifyNativeCommand}"
                HorizontalAlignment="Left" AutomationProperties.Name="{x:Static resources:Strings.VerifyNative}" />
        <TextBox Grid.Row="3" Text="{Binding Status, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                 Background="{StaticResource SurfaceBrush}" Foreground="{StaticResource TextPrimaryBrush}"
                 BorderThickness="0" Padding="12" Margin="0,20,0,0" VerticalScrollBarVisibility="Auto" />
    </Grid>
</Window>
